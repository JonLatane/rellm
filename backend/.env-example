DATABASE_URL=postgres://localhost/rellm_dev
# Separate DB used by `cargo test` (see backend/src/tests/), so specs never touch dev data.
TEST_DATABASE_URL=postgres://localhost/rellm_test

MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=
MINIO_BUCKET=rellm-dev
MINIO_ACCESS_KEY=ROOTNAME
MINIO_SECRET_KEY=CHANGEME123

# Semantic search (optional). The server and jobs never load an embedding model themselves; they call the cluster's
# embedding service, run locally with `make run_embedding_service` (or `make run_tmux_with_semantic_search`).
# Without these, search is plain Postgres full-text search.
RELLM_EMBEDDING_SERVICE_URL=http://localhost:8090
RELLM_EMBEDDING_SERVICE_SECRET=local-dev
# Optional vector index service for the namespace (`make run_vector_service`); without it searches scan Postgres.
# RELLM_VECTOR_SERVICE_URL=http://localhost:8091
RELLM_VECTOR_SERVICE_SECRET=local-dev
