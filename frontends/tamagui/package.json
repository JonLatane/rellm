{
  "name": "rellm-tamagui-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "watch": "yarn workspaces foreach -pi run watch",
    "version:install": "yarn set version 4.5 && yarn install",
    "web": "yarn build && cd apps/next && TAMAGUI_TARGET=web yarn next",
    "web:extract": "DISABLE_EXTRACTION=false yarn workspace next-app dev",
    "web:prod:build": "yarn workspace next-app build",
    "web:prod:serve": "yarn workspace next-app serve",
    "fix": "manypkg fix",
    "postinstall": "yarn check-deps && yarn build",
    "build": "yarn workspaces foreach --all --exclude next-app run build",
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary",
    "upgrade:tamagui:old": "yarn up '*tamagui*'@canary '@tamagui/*'@canary react-native-web-lite@latest",
    "upgrade:tamagui:canary:old": "yarn up '*tamagui*'@canary '@tamagui/*'@canary react-native-web-lite@canary",
    "check-deps": "check-dependency-version-consistency .",
    "check-tamagui": "tamagui check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "protos": "protoc --plugin=\"./node_modules/.bin/protoc-gen-ts_proto\" -I ../../protos/ --ts_proto_opt=esModuleInterop=true --ts_proto_opt=useDate=string --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=outputClientImpl=grpc-web --ts_proto_opt=lowerCaseServiceMethods=true --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions --ts_proto_out=\"./packages/api/generated\" ../../protos/rellm.proto"
  },
  "resolutions": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-refresh": "^0.14.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "@tootallnate/once@npm:2.0.0": "2.0.1",
    "ajv@npm:8.11.0": "8.18.0",
    "ajv@npm:8.6.3": "8.18.0",
    "body-parser@npm:1.20.3": "1.20.9",
    "decode-uri-component@npm:^0.2.2": "0.5.0",
    "glob@npm:10.3.10": "10.5.0",
    "http-cache-semantics@npm:^4.1.1": "4.3.0",
    "image-size@npm:^1.0.2": "2.0.3",
    "ip-address@npm:^9.0.5": "10.7.5",
    "linkify-it@npm:^2.0.0": "5.0.2",
    "markdown-it@npm:^8.4.0": "14.3.1",
    "path-to-regexp@npm:0.1.12": "0.1.13",
    "postcss@npm:8.4.31": "8.5.23",
    "postcss@npm:8.4.49": "8.5.23",
    "postcss@npm:~8.4.32": "8.5.23",
    "qs@npm:6.13.0": "6.16.1",
    "qs@npm:~6.15.1": "6.16.1",
    "tar@npm:6.2.1": "7.5.21",
    "undici@npm:5.28.4": "6.28.1",
    "undici@npm:^5.28.4": "6.28.1",
    "uuid@npm:^7.0.3": "11.1.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@tamagui/cli": "^1.132.7",
    "check-dependency-version-consistency": "^4.1.0",
    "eslint": "^9.3.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "ts-proto": "^2.7.5",
    "turbo": "^2.9.14",
    "typescript": "~5.8.3",
    "ultra-runner": "^3.10.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": "22",
    "npm": "10.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3"
  }
}
